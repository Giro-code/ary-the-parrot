[Unit]
Description=Ary Chromium kiosk
After=graphical-session.target

[Service]
Type=simple
EnvironmentFile=%h/.config/ary/kiosk.env
ExecStart=/usr/bin/chromium --kiosk --no-first-run --noerrdialogs --disable-session-crashed-bubble --user-data-dir=%h/.config/ary/chromium ${ARY_KIOSK_URL}
Restart=on-failure
RestartSec=5

[Install]
WantedBy=graphical-session.target
