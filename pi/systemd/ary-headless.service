[Unit]
Description=Ari sin pantalla: microfono, IA (Gemini via la web) o voz local, y movimiento
After=network-online.target sound.target
Wants=network-online.target
# No usar a la vez que ary-bridge con --serial: comparten el puerto del Arduino.
Conflicts=ary-bridge.service

[Service]
Type=simple
User=ari
SupplementaryGroups=dialout audio
WorkingDirectory=/home/ari/ary/pi
Environment=PYTHONUNBUFFERED=1
# Microfono USB al maximo (si no esta conectado, se ignora).
ExecStartPre=-/usr/bin/amixer -D hw:Device sset Mic 100% cap
ExecStart=/home/ari/ary/venv/bin/python -m headless --greet --mic plughw:CARD=Device,DEV=0 --serial /dev/serial/by-id/usb-Silicon_Labs_CP2102_USB_to_UART_Bridge_Controller_0001-if00-port0
# Si falta el microfono o algo falla, reintenta cada 10 s (p. ej. al conectar el microfono despues).
Restart=always
RestartSec=10
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
