{
  "name": "ary-la-cotorra",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": "24.x" },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --configLoader native",
    "test:e2e": "playwright test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node scripts/database.ts migrate",
    "db:seed": "node scripts/database.ts seed",
    "kiosk:enroll": "node scripts/database.ts enroll",
    "db:cleanup": "node scripts/database.ts cleanup",
    "check:kiosk-budget": "node scripts/kiosk-budget.mjs",
    "admin:create": "node scripts/admin-demo.ts admin:create",
    "demo:seed": "node scripts/admin-demo.ts demo:seed",
    "demo:reset": "node scripts/admin-demo.ts demo:reset",
    "deploy:secrets": "node scripts/deploy-secrets.ts",
    "deploy:check": "node scripts/deploy-check.ts",
    "build:empty-env": "node scripts/build-empty-env.ts"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.15",
    "@neondatabase/serverless": "^1.2.0",
    "drizzle-orm": "^0.45.4",
    "next": "16.4.5",
    "qrcode": "^1.5.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "ws": "^8.22.1",
    "zod": "^4.6.7"
  },
  "overrides": {
    "@typescript-eslint/typescript-estree": {
      "minimatch": "11.0.5"
    }
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "@types/node": "26.6.6",
    "@types/pngjs": "6.0.5",
    "@types/qrcode": "^1.5.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/ws": "^8.18.2",
    "drizzle-kit": "^0.31.11",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.5",
    "pixelmatch": "8.0.0",
    "pngjs": "7.0.0",
    "typescript": "6.0.3",
    "vitest": "5.1.0"
  }
}
