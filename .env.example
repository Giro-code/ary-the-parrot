# Producción. En desarrollo usar http://localhost:3000.
APP_BASE_URL=https://arytheparrot.app
DATABASE_URL=
AUTH_SECRET=
SESSION_ENCRYPTION_KEY=
RESEND_API_KEY=
EMAIL_FROM=
EMAIL_REPLY_TO=
RESEND_WEBHOOK_SECRET=
ADMIN_NOTIFICATION_EMAIL=
CRON_SECRET=
GEMINI_API_KEY=
AI_MODEL=gemini-3.5-flash-lite
AI_SESSION_PER_MINUTE=6
AI_GLOBAL_PER_MINUTE=30
ROBOT_DEVICE_AUTH_SECRET=
ROBOT_BRIDGE_SECRET=
# Pi only. Use the enrolled kiosk's public_device_id, never a visitor identifier.
ROBOT_DEVICE_ID=
# Valores propuestos para etapas posteriores, pendientes de revisión de retención.
ANALYTICS_RETENTION_DAYS=90
PROVIDER_LEAD_RETENTION_DAYS=30
VISITOR_SESSION_TTL_HOURS=24
QR_HANDOFF_TTL_SECONDS=120
# Requerida en producción para hashes de rate limit, distinta de claves de servicios.
RATE_LIMIT_SALT=
# Solo desarrollo/pruebas; en producción DATABASE_URL es obligatoria.
PGLITE_DATA_DIR=.pglite
FEATURE_ENABLE_MARKETING=false
FEATURE_ENABLE_PARTNER_SHARING=false
EMAIL_DRY_RUN=true
# Stage 6: server-only speech, same GEMINI_API_KEY. Never expose with NEXT_PUBLIC_.
AI_TTS_MODEL=gemini-3.8-flash-lite-tts
AI_TTS_VOICE=Sulafat
AI_TTS_SESSION_PER_MINUTE=8
AI_TTS_GLOBAL_PER_MINUTE=30

# Airport kiosk resets to this supported language, independently of the visitor cookie/country.
KIOSK_DEFAULT_LOCALE=en
