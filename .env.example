# Producción. En desarrollo usar http://localhost:3000.
APP_BASE_URL=https://arytheparrot.app
DATABASE_URL=
AUTH_SECRET=
SESSION_ENCRYPTION_KEY=
RESEND_API_KEY=
EMAIL_FROM=
EMAIL_REPLY_TO=
CRON_SECRET=
AI_GATEWAY_API_KEY=
AI_MODEL=
ROBOT_DEVICE_AUTH_SECRET=
ROBOT_MODE=simulator
# Valores propuestos para etapas posteriores, pendientes de revisión de retención.
ANALYTICS_RETENTION_DAYS=90
VISITOR_SESSION_TTL_HOURS=24
QR_HANDOFF_TTL_SECONDS=120
# Requerida en producción para hashes de rate limit, distinta de claves de servicios.
RATE_LIMIT_SALT=
# Solo desarrollo/pruebas; en producción DATABASE_URL es obligatoria.
PGLITE_DATA_DIR=.pglite
FEATURE_ENABLE_MARKETING=false
FEATURE_ENABLE_PARTNER_SHARING=false
EMAIL_DRY_RUN=true
